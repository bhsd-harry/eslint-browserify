{
	"name": "@bhsd/eslint-browserify",
	"version": "10.3.0",
	"description": "ESLint in browser",
	"keywords": [
		"eslint",
		"lint",
		"linter",
		"browser"
	],
	"homepage": "https://github.com/bhsd-harry/eslint-browserify#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/eslint-browserify/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"dist/index.d.ts",
		"bundle/eslint.min.js",
		"bundle/*.LEGAL.txt"
	],
	"main": "./bundle/eslint.min.js",
	"browser": "bundle/eslint.min.js",
	"types": "dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/eslint-browserify.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"lint:ts": "tsc --noEmit && eslint --cache --report-unused-disable-directives-severity 0 . && eslint --no-ignore --no-inline-config --no-config-lookup -c eslint.build.mjs build/eslint.js",
		"lint:bundle": "eslint --no-ignore --no-config-lookup --report-unused-disable-directives-severity 0 --no-inline-config --rule 'no-unused-vars: [2, {args: \"none\", caughtErrors: \"none\", ignoreRestSiblings: true}]' build/eslint.js",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:md",
		"build": "npm run bundle && npm run minify && tsc",
		"bundle": "node build.js",
		"minify": "esbuild src/iife.ts --charset=utf8 --bundle --minify --target=es2019 --outfile=bundle/eslint.min.js --legal-comments=external && esbuild build/eslint.js --charset=utf8 --minify --sourcemap --target=es2019 --outfile=bundle/coverage.min.js",
		"coverage": "c8 npm run test:coverage && node test/coverage.js",
		"test": "mocha --require bundle/eslint.min.js test/tests/*.js",
		"test:linter": "mocha --require bundle/eslint.min.js test/linter.test.js",
		"test:migrate": "mocha --require bundle/eslint.min.js test/migrate.test.js",
		"test:coverage": "mocha test/tests/*.js && mocha test/linter.test.js && mocha test/migrate.test.js",
		"clean": "find test/tests/ -type f -name '*.js' | xargs gsed -i 's|\"../../../lib/rule-tester/rule-tester\"|\"../rule-tester\"| ; s|rule = require(.*)|rule = __filename| ; s|\"../../_utils\"|\"../utils\"| ; s|rule-to-test/||g'; eslint --fix --report-unused-disable-directives-severity 0 test/tests/*.js"
	},
	"c8": {
		"reporter": [
			"json",
			"json-summary",
			"text"
		],
		"include": [
			"bundle/coverage.min.js"
		]
	},
	"dependencies": {
		"eslint": "^10.3.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.4.2",
		"@bhsd/test-util": "^1.3.1",
		"@eslint/eslintrc": "^3.3.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.2",
		"@typescript-eslint/parser": "^8.59.2",
		"c8": "^11.0.0",
		"esbuild": "^0.28.0",
		"globals": "^17.6.0",
		"markdownlint-cli2": "^0.22.1",
		"mocha": "^11.7.5",
		"sinon": "^22.0.0",
		"typescript": "^6.0.3"
	}
}
