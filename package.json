{
	"name": "@bhsd/eslint-browserify",
	"version": "10.2.0",
	"description": "ESLint in browser",
	"keywords": [
		"eslint",
		"lint",
		"linter",
		"browser"
	],
	"homepage": "https://github.com/bhsd-harry/eslint-browserify#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/eslint-browserify/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"dist/index.d.ts",
		"bundle/eslint.min.js",
		"bundle/*.LEGAL.txt"
	],
	"main": "./bundle/eslint.min.js",
	"browser": "bundle/eslint.min.js",
	"types": "dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/eslint-browserify.git"
	},
	"scripts": {
		"lint:ts": "tsc --noEmit && eslint --cache --report-unused-disable-directives-severity 0 . && eslint --no-ignore --no-inline-config --no-config-lookup -c eslint.build.mjs build/eslint.js",
		"lint:bundle": "eslint --no-ignore --no-config-lookup --report-unused-disable-directives-severity 0 --rule 'no-unused-vars: [2, {args: \"none\"}]' build/eslint.js",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint": "npm run lint:ts && npm run lint:md",
		"build": "npm run bundle && npm run minify && tsc",
		"bundle": "node build.js",
		"minify": "esbuild src/iife.ts --charset=utf8 --bundle --minify --target=es2019 --outfile=bundle/eslint.min.js && esbuild build/eslint.js --charset=utf8 --minify --sourcemap --target=es2019 --outfile=bundle/coverage.min.js",
		"coverage": "c8 mocha && node test/coverage.js",
		"test": "mocha --require bundle/eslint.min.js",
		"test:migrate": "mocha --require bundle/eslint.min.js test/migrate.test.js",
		"clean": "find test/tests/ -type f -name '*.js' | xargs gsed -i 's|\"../../../lib/rule-tester/rule-tester\"|\"../rule-tester\"| ; s|rule = require(.*)|rule = __filename| ; s|\"../../_utils\"|\"../utils\"| ; s|rule-to-test/||g'; eslint --fix --report-unused-disable-directives-severity 0 test/tests/*.js"
	},
	"c8": {
		"reporter": [
			"json",
			"text"
		],
		"include": [
			"bundle/coverage.min.js"
		]
	},
	"dependencies": {
		"eslint": "^10.2.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^2.2.0",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.11.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"c8": "^11.0.0",
		"esbuild": "^0.27.7",
		"eslint-plugin-es-x": "^9.6.0",
		"eslint-plugin-jsdoc": "^62.7.1",
		"eslint-plugin-jsonc": "^3.1.2",
		"eslint-plugin-n": "^17.24.0",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"globals": "^17.4.0",
		"markdownlint-cli2": "^0.21.0",
		"mocha": "^11.7.5",
		"typescript": "^6.0.2"
	},
	"overrides": {
		"eslint": "^10.2.0"
	}
}
