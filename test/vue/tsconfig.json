{
	"extends": "../../tsconfig.json",
	"include": [
		"src/*.ts"
	],
	"compilerOptions": {
		"types": [
			"node",
			"mocha"
		],
		"target": "es2024",
		"module": "esnext",
		"declaration": false,
		"emitDeclarationOnly": false,
		"rootDir": "src",
		"outDir": "dist",
		"exactOptionalPropertyTypes": false,
		"noImplicitAny": false,
		"noUnusedParameters": false,
		"strictNullChecks": false
	}
}
